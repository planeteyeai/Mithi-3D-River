# History API (mithi-history-api) — copy to server/.env (gitignored)
# Loaded automatically via server/loadEnv.js

# Required: Postgres from Docker Compose (host port 5433)
DATABASE_URL=postgresql://mithi:mithi@127.0.0.1:5433/mithi_river

# Project namespace for component_history rows
MITHI_PROJECT_ID=mithi

# Local listen port (Render sets PORT in production)
HISTORY_API_PORT=5181

# Optional tuning
PG_POOL_MAX=10
HISTORY_REQUEST_TIMEOUT_MS=25000

# Optional CORS lock
# CORS_ORIGIN=http://127.0.0.1:5180
