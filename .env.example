###############################################################################
# Mithi River Digital Twin — environment template
# Copy to .env for local use. Never commit real secrets.
#
# HOSTING: full stack on Render (see render.yaml)
# LOCAL:   Docker Postgres :5433 + Express :5181 + Vite :5180
###############################################################################

# ---------------------------------------------------------------------------
# 1. Frontend (Vite) — public; inlined at BUILD time as import.meta.env.VITE_*
# ---------------------------------------------------------------------------

# Same-origin history API (Vite proxy locally; Express on Render)
VITE_HISTORY_API_BASE=/api/history

# Same-origin proxies (defaults if unset)
VITE_JALNETRA_API_BASE=/jalnetra-api
VITE_RIVEREYE_API=/rivereye-api
# VITE_RIVEREYE_ASSET_BASE=
# VITE_ANALYTICS_API_BASE=
# VITE_BOD_COD_VIEWER_ID=

# ---------------------------------------------------------------------------
# Render (Dashboard → Environment) — blueprint sets these automatically.
# Upstream originals (Express proxies to these):
#   JALNETRA_UPSTREAM=https://jalnetra-software-production.up.railway.app
#   RIVEREYE_UPSTREAM=https://rivereye-production.up.railway.app
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 2. Backend — history API (server/) — NEVER use VITE_ prefix
# ---------------------------------------------------------------------------

HISTORY_API_PORT=5181
HISTORY_REQUEST_TIMEOUT_MS=25000
# SERVE_SPA=1
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# 3. Database — LOCAL Docker Compose Postgres (host port 5433)
#    On Render: DATABASE_URL is injected from mithi-river-db
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://mithi:mithi@127.0.0.1:5433/mithi_river
MITHI_PROJECT_ID=mithi
PG_POOL_MAX=10

# Optional CORS lock for local SPA
# CORS_ORIGIN=http://127.0.0.1:5180
