###############################################################################
# Mithi River Digital Twin — environment template
# Copy to .env for local use. Never commit real secrets.
#
# DEFAULT: local backend (Docker Postgres :5433 + Express :5181)
# When you get a hosted history API URL later, replace DATABASE_URL /
# HISTORY_API_PUBLIC_URL and add Vercel rewrites (see README).
###############################################################################

# ---------------------------------------------------------------------------
# 1. Frontend (Vite) — public; inlined at BUILD time as import.meta.env.VITE_*
# ---------------------------------------------------------------------------

# Browser → Vite proxy → local Express on :5181 (LOCAL ONLY)
VITE_HISTORY_API_BASE=/api/history

# Optional overrides (defaults already use /jalnetra-api + /rivereye-api proxies)
# VITE_JALNETRA_API_BASE=/jalnetra-api
# VITE_RIVEREYE_API=/rivereye-api
# VITE_RIVEREYE_ASSET_BASE=
# VITE_ANALYTICS_API_BASE=
# VITE_BOD_COD_VIEWER_ID=

# ---------------------------------------------------------------------------
# Vercel (frontend only) — set these in the Vercel project Environment Variables
# Do NOT copy DATABASE_URL / HISTORY_API_PORT / localhost values to Vercel.
# ---------------------------------------------------------------------------
# Leave VITE_HISTORY_API_BASE empty until you have a hosted history API URL.
# VITE_JALNETRA_API_BASE=/jalnetra-api
# VITE_RIVEREYE_API=/rivereye-api
# Enable Git LFS in the Vercel project (Settings → Git) so satellite_imagery.jpg deploys.

# ---------------------------------------------------------------------------
# 2. Backend — history API (server/) — NEVER use VITE_ prefix
# ---------------------------------------------------------------------------

HISTORY_API_PORT=5181
HISTORY_REQUEST_TIMEOUT_MS=25000

# FUTURE (hosted API) — leave empty until you have a public URL
# HISTORY_API_PUBLIC_URL=https://YOUR-HISTORY-API.onrender.com

# ---------------------------------------------------------------------------
# 3. Database — LOCAL Docker Compose Postgres (host port 5433)
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://mithi:mithi@127.0.0.1:5433/mithi_river
MITHI_PROJECT_ID=mithi
PG_POOL_MAX=10

# Optional CORS lock for local SPA
# CORS_ORIGIN=http://127.0.0.1:5180
